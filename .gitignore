# Markdown working notes are private; keep only README and docs/ tracked.
*.md
!README.md
!docs/**/*.md

# Third-party papers (copyrighted PDFs) — do not redistribute.
# Our own report figures under figures/ are kept (re-included below).
*.pdf
!figures/**/*.pdf

# Model checkpoints / weights (multi-GB — never commit)
ckpt/
checkpoints/
models/
*.pth
*.safetensors
*.bin
*.gguf

# Cloned LayerSkip codebase: ignore the upstream tree, track only the files
# QuantShift modifies.
# (Note: .gitignore has no inline end-of-line comments — comments go on their own line.)
# (Git rule: ignoring a whole parent dir blocks re-including files inside it, so
#  use the "ignore contents (*) + re-include individual files" pattern.)
/LayerSkip/*
# quantization injection + single-GPU setup() patch
!/LayerSkip/generate.py
# quantize/quant_double/compute_dtype flags
!/LayerSkip/arguments.py
# re-include the subdir, then ignore its contents, then re-include individual files
!/LayerSkip/self_speculation/
/LayerSkip/self_speculation/*
# shadow-token hooking + D(E)
!/LayerSkip/self_speculation/llama_model_utils.py
# shadow acceptance + rejected-token logging
!/LayerSkip/self_speculation/self_speculation_generator.py

# Experiment logs / results (regenerated by the scripts)
logs/
outputs/
*.log
wandb/

# Dataset cache
data/
.cache/
*.arrow

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc
*.lof
*.lot
acl_latex.pdf

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# OS / editor / local harness state
.DS_Store
.vscode/
.idea/
.claude/
